<mxfile host="app.diagrams.net" type="device"><diagram id="week3-pipeline" name="Executed V1 Pipeline"><mxGraphModel dx="1480" dy="1320" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1480" pageHeight="1320"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Week 3 | Executed V1 Data Pipeline&lt;/b&gt;&lt;br&gt;Explainable Student Dropout Prediction · Woo Yong Kang · A24AI0123" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=21;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1400" height="70" /></mxCell><mxCell id="lane_t" value="&lt;b&gt;TABULAR · D1 → A7 · FR2 / NFR4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#DBEAFE;strokeColor=#93C5FD;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="115" width="650" height="50" /></mxCell><mxCell id="lane_d" value="&lt;b&gt;DOCUMENTS · D2 → A6 · FR5 / RAI4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#CCFBF1;strokeColor=#5EEAD4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="115" width="650" height="50" /></mxCell><mxCell id="t1" value="&lt;b&gt;1  SOURCE&lt;/b&gt;&lt;br&gt;S01 · UCI CSV · 4,424 records / 36 features" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="190" width="650" height="80" /></mxCell><mxCell id="d1" value="&lt;b&gt;1  SOURCE&lt;/b&gt;&lt;br&gt;S02 + S03 · public papers · 17 + 15 PDF pages" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="190" width="650" height="80" /></mxCell><mxCell id="t2" value="&lt;b&gt;2  INGEST&lt;/b&gt;&lt;br&gt;Explicit filename + approved SHA-256; parse with &amp;quot;;&amp;quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="310" width="650" height="80" /></mxCell><mxCell id="d2" value="&lt;b&gt;2  INGEST&lt;/b&gt;&lt;br&gt;Explicit PDF list + SHA-256; extract page by page" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="310" width="650" height="80" /></mxCell><mxCell id="t3" value="&lt;b&gt;3  INSPECT&lt;/b&gt;&lt;br&gt;Check schema, labels, missing values and duplicates&lt;br&gt;Reject unexpected dimensions or columns" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="430" width="650" height="90" /></mxCell><mxCell id="d3" value="&lt;b&gt;3  INSPECT&lt;/b&gt;&lt;br&gt;Check nonempty page text and retained page identity&lt;br&gt;Flag table / sidebar / repeated-extraction issues" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="430" width="650" height="90" /></mxCell><mxCell id="t4" value="&lt;b&gt;4  PREPARE&lt;/b&gt;&lt;br&gt;Trim whitespace; quarantine repeats/conflicting labels&lt;br&gt;Separate T0 (8), T1 (14), target and audit fields" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="560" width="650" height="100" /></mxCell><mxCell id="d4" value="&lt;b&gt;4  PREPARE&lt;/b&gt;&lt;br&gt;Minimal cleaning + page-aware paragraph/line chunks&lt;br&gt;Maximum 1,000 characters; zero overlap" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="560" width="650" height="100" /></mxCell><mxCell id="t5" value="&lt;b&gt;5  VALIDATE → STORE&lt;/b&gt;&lt;br&gt;Read-back equality, ranges, allowlists and row alignment&lt;br&gt;Promote 7 validated files from temporary storage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="700" width="650" height="100" /></mxCell><mxCell id="d5" value="&lt;b&gt;5  VALIDATE → STORE&lt;/b&gt;&lt;br&gt;168 chunks: unique IDs, exact spans and page coverage&lt;br&gt;Promote one candidate-text JSONL; manual review remains" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="700" width="650" height="100" /></mxCell><mxCell id="t6" value="&lt;b&gt;6  RECORD LINEAGE&lt;/b&gt;&lt;br&gt;data/pipeline_v1/tabular/pipeline_manifest.json&lt;br&gt;Inputs, config, outputs, hashes and row mappings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="840" width="650" height="100" /></mxCell><mxCell id="d6" value="&lt;b&gt;6  RECORD LINEAGE&lt;/b&gt;&lt;br&gt;data/pipeline_v1/documents/pipeline_manifest.json&lt;br&gt;Two source mappings, pages, hashes and warnings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#F0FDFA;strokeColor=#5EEAD4;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="840" width="650" height="100" /></mxCell><mxCell id="repeat" value="&lt;b&gt;REPEATABILITY + PART B PARITY&lt;/b&gt;&lt;br&gt;Run each branch twice; compare fingerprints, sizes, counts and mappings.&lt;br&gt;Fresh raw-only workspace also matches. Timestamps may differ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="985" width="980" height="95" /></mxCell><mxCell id="f1" value="&lt;b&gt;F1  Missing / changed input → STOP&lt;/b&gt;&lt;br&gt;Report source ID; restore the approved file/version.&lt;br&gt;No new successful run is recorded.&lt;br&gt;Missing-file response exercised in a temporary workspace." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1120" width="650" height="115" /></mxCell><mxCell id="f2" value="&lt;b&gt;F2  Empty / altered output → FAIL&lt;/b&gt;&lt;br&gt;Reject before success; inspect, rerun and re-verify.&lt;br&gt;Manifest is written only after validation.&lt;br&gt;Empty-output response exercised on a temporary copy." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=18;fontColor=#0F172A;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="770" y="1120" width="650" height="115" /></mxCell><mxCell id="footer" value="&lt;b&gt;Data preparation only. No model fitting, split creation, vector index or finished guide is claimed.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=22;spacingRight=15;fontFamily=Helvetica;fontSize=19;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1260" width="1360" height="40" /></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;exitX=0.5;exitY=1;entryY=0;entryX=0.5;" edge="1" parent="1" source="t1" target="t2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;exitX=0.5;exitY=1;entryY=0;entryX=0.5;" edge="1" parent="1" source="t2" target="t3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;exitX=0.5;exitY=1;entryY=0;entryX=0.5;" edge="1" parent="1" source="t3" target="t4"><mxGeometry as="geometry" relative="1" /></mxC